events {}

http {
  resolver 127.0.0.11 valid=5s ipv6=off;
  client_max_body_size 21m;

  map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
  }

  map $host $internal_tls_upstream {
    appview.uat.test http://appview:3000;
    default http://pds:3000;
  }

  server {
    listen 80;

    location /api/ {
      set $rice_upstream rice:4000;
      proxy_pass http://$rice_upstream;
      proxy_set_header Host ${PUBLIC_HOST};
      proxy_set_header X-Forwarded-Host ${PUBLIC_HOST};
      proxy_set_header X-Forwarded-Proto ${PUBLIC_SCHEME};
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location = /pds {
      return 308 /pds/;
    }

    location /pds/ {
      proxy_pass http://pds:3000/;
      proxy_http_version 1.1;
      proxy_set_header Host pds.uat.test;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_read_timeout 300s;
    }

    location = /post {
      return 308 /post/;
    }

    # Public media and anonymous thread reading share the deployment origin.
    # Only expose the read paths the frontend actually uses.
    location /bsky/img/ {
      limit_except GET HEAD { deny all; }
      set $appview_upstream appview:3000;
      rewrite ^/bsky/(.*)$ /$1 break;
      proxy_pass http://$appview_upstream;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
    }

    location = /bsky/xrpc/app.bsky.feed.getPostThread {
      limit_except GET HEAD { deny all; }
      set $appview_upstream appview:3000;
      rewrite ^/bsky/(.*)$ /$1 break;
      proxy_pass http://$appview_upstream;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
    }

    location /post/ {
      proxy_pass http://post-cache:8080/;
      proxy_set_header Host $host;
    }

    location / {
      set $frontend_upstream frontend:3000;
      proxy_pass http://$frontend_upstream;
      proxy_http_version 1.1;
      proxy_set_header Host ${PUBLIC_HOST};
      proxy_set_header X-Forwarded-Host ${PUBLIC_HOST};
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto ${PUBLIC_SCHEME};
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
    }
  }

  server {
    listen 443 ssl;
    server_name *.uat.test uat.test;
    ssl_certificate /etc/nginx/certs/server.crt;
    ssl_certificate_key /etc/nginx/certs/server.key;

    location / {
      proxy_pass $internal_tls_upstream;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_read_timeout 300s;
    }
  }
}
