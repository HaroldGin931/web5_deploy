# Append to the server's existing compose/.env; do not replace that file.
# Fill secrets on the server only. Empty credentials keep the corresponding entry closed.
SEMI_CLIENT_ID=
SEMI_CLIENT_SECRET=
# 32 bytes, base64. Reuse the existing key if semi_links already exist.
RICE_LINK_ENC_KEY=

# live: real provider only. log: explicit isolated-test mode, no SMS/email sent.
RICE_VERIFICATION_MODE=live
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

SMTP_RELAY=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_NAME=乡建DAO
SMTP_SENDER_ADDRESS=
