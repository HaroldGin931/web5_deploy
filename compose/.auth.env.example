# 复制为同目录 auth.env，只在服务器填写。不要提交真实密钥。
# 值含 $、# 或空格时，用英文单引号包裹，例如 KEY='实际值'。
# 填完执行 README 中的命令生效；无需修改基础设施的 .env。

# 阿里云短信：填对方提供的这五项。endpoint 使用完整 https:// 地址。
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_ENDPOINT=https://dysmsapi.aliyuncs.com
# live 真实发送；log 仅隔离测试写日志。这里保持 live。
RICE_VERIFICATION_MODE=live

# Semi OAuth：填 clientID 和 client Secret。
# 已登记的 Redirect URI：https://demo.wamo.social/callback（Compose 按部署域名设置）。
SEMI_CLIENT_ID=
SEMI_CLIENT_SECRET=
# Rice 自己的加密密钥，不是 Semi secret；已有8个绑定必须沿用旧部署的原值。
# 没拿到时先留空，不影响短信；Semi 入口暂不启用。
RICE_LINK_ENC_KEY=

# 可选邮件通道：需要时取消注释并填写；只用短信无需配置。
# SMTP_RELAY=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_SENDER_NAME=乡建DAO
# SMTP_SENDER_ADDRESS=
